{
  "name": "after-the-buzzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787 --var LOCAL_DEV:true",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply nba-recap --local",
    "db:remote": "wrangler d1 migrations apply nba-recap --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.40.0"
  }
}
